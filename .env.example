# ── Supabase ──────────────────────────────────────────────────
# Get from: supabase.com → project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Anthropic (Claude API) ─────────────────────────────────────
# Get from: console.anthropic.com → API Keys
# IMPORTANT: Only used in Supabase Edge Functions (server-side)
# Never expose this in the frontend
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Job Board APIs ────────────────────────────────────────────
# Adzuna: api.adzuna.com → register for free
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── App Config ────────────────────────────────────────────────
VITE_APP_URL=https://your-app.vercel.app

# ── Email (for daily digest) ──────────────────────────────────
# Use Resend.com (free tier: 3000/mo)
RESEND_API_KEY=re_your_key_here
DIGEST_FROM_EMAIL=digest@yourapp.com
